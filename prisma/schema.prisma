generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_MYSQL")
  // shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String? // Optional, since SSO users might not have a password
  name        String
  ssoProvider String? // e.g., 'google', 'facebook', etc.
  ssoId       String?   @unique // Unique ID from the SSO provider
  accounts    Account[] // One-to-many relationship with Account
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([id])
  @@index([name, deletedAt])
}

model Account {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  accountName String        @default("")
  balance     Float         @default(0.0)
  currency    String        @default("IDR")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  Transaction Transaction[]
  Label       Label[]

  @@index([id])
  @@index([accountName, userId, deletedAt])
}

model Transaction {
  id             String          @id @default(uuid())
  accountId      String
  account        Account         @relation(fields: [accountId], references: [id])
  labelId        String
  label          Label           @relation(fields: [labelId], references: [id])
  amount         Float
  remark         String          @default("")
  type           TransactionType
  statusApproval StatusApproval
  reason         String          @default("")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  @@index([id])
  @@index([accountId, labelId, deletedAt])
}

model Label {
  id            String        @id @default(uuid())
  name          String
  labelParentId String?
  accountId     String?
  account       Account?      @relation(fields: [accountId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  transaction   Transaction[]

  @@index([id])
  @@index([accountId, name, deletedAt])
}

enum TransactionType {
  DEBET
  CREDIT
}

enum StatusApproval {
  CREATED
  APRROVED
  REJECTED
  MODIFYED
}
